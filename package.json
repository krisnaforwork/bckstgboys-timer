{
  "name": "bckstgboys-timer",
  "productName": "BCKSTGBOYS TIMER",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.bckstgboys.timer",
    "productName": "BCKSTGBOYS TIMER",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "index.html"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.ico",
      "artifactName": "${BCKSTGBOYS TIMER}.${ext}"
    },
    "nsis": {
      "artifactName": "${BCKSTGBOYS TIMER} Installer.${ext}"
    }
  }
}